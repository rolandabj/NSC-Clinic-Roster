rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Identity helpers
    // Access is granted from the signed in user's userAccess record, whose
    // document id is the user's lowercased email address.
    // ---------------------------------------------------------------------

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isOwner() {
      return signedIn() && myEmail() == 'rolandabj@gmail.com';
    }

    function accessPath() {
      return /databases/$(database)/documents/userAccess/$(myEmail());
    }

    function hasAccessRecord() {
      return signedIn() && exists(accessPath());
    }

    function access() {
      return get(accessPath()).data;
    }

    // Approved users can read clinic data.
    function isApproved() {
      return isOwner() || (hasAccessRecord() && access().status == 'APPROVED');
    }

    // Editors can change clinic data.
    function isEditor() {
      return isOwner() || (isApproved() && access().appRole == 'EDITOR');
    }

    // Managers approve leave and availability requests (and editors can too).
    // A manager is not an editor: she can't change rosters, staff or settings.
    function canApprove() {
      return isEditor() || (isApproved() && access().isManager == true);
    }

    // ---------------------------------------------------------------------
    // User access whitelist: only the owner manages it.
    // A signed in user may read their own record and may file a single
    // PENDING request for themselves, with no privileges.
    // ---------------------------------------------------------------------
    match /userAccess/{userEmail} {
      allow get: if signedIn() && (userEmail == myEmail() || isOwner());
      allow list: if isOwner();

      allow create: if isOwner() || (
        signedIn()
        && userEmail == myEmail()
        && request.resource.data.keys().hasOnly(['id', 'email', 'name', 'status', 'appRole', 'isManager', 'approvedBy', 'createdAt', 'updatedAt'])
        && request.resource.data.email == myEmail()
        && request.resource.data.status == 'PENDING'
        && request.resource.data.appRole == 'VIEWER'
        && request.resource.data.isManager == false
      );

      allow update, delete: if isOwner();
    }

    // ---------------------------------------------------------------------
    // Acknowledgments: the document id is the random token emailed to the
    // nurse. Knowing the token is what allows reading that one record and
    // confirming receipt (setting ackAt once), even without signing in.
    // ---------------------------------------------------------------------
    match /acknowledgments/{ackId} {
      allow get: if isEditor() || resource.data.token == ackId
        || (isApproved() && myNurseId() != '' && resource.data.nurseId == myNurseId());
      // Who confirmed what is for the people who publish rosters.
      allow list: if isEditor();
      allow create, delete: if isEditor();
      allow update: if isEditor() || (
        // By the token from the email (no sign in needed), or for older
        // acknowledgments whose id is not the token, by the nurse herself.
        (resource.data.token == ackId || (isApproved() && myNurseId() != '' && resource.data.nurseId == myNurseId()))
        && resource.data.get('ackAt', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ackAt'])
        && request.resource.data.ackAt is string
      );
    }

    // ---------------------------------------------------------------------
    // Public roster snapshots: the document id is the random share token.
    // Anyone holding the link can read that one snapshot (never list them).
    // Restricted links are for staff accounts: they only open for the listed
    // signed in email addresses (and for editors, who manage the links).
    // ---------------------------------------------------------------------
    match /publicRosters/{token} {
      allow get: if resource.data.revoked != true && (
        resource.data.isPublic == true
        || (signedIn() && myEmail() in resource.data.allowedEmails)
        || isEditor()
      );
      allow list: if false;
      allow write: if isEditor();
    }

    // ---------------------------------------------------------------------
    // Staff self service: an approved user linked to a nurse profile may file
    // and cancel their own PENDING leave and availability requests. Managers
    // and editors decide them.
    // ---------------------------------------------------------------------
    function myNurseId() {
      return hasAccessRecord() ? access().get('linkedNurseId', '') : '';
    }

    function isOwnPendingRequest(data) {
      return isApproved()
        && myNurseId() != ''
        && data.nurseId == myNurseId()
        && data.status == 'PENDING';
    }

    match /leaveEntries/{leaveId} {
      allow read: if isApproved();
      allow create: if canApprove() || (
        isOwnPendingRequest(request.resource.data)
        && request.resource.data.approved == false
      );
      allow update: if canApprove();
      allow delete: if canApprove() || isOwnPendingRequest(resource.data);
    }

    match /availabilityRequests/{requestId} {
      allow read: if isApproved();
      allow create: if canApprove() || isOwnPendingRequest(request.resource.data);
      allow update: if canApprove();
      allow delete: if canApprove() || isOwnPendingRequest(resource.data);
    }

    // Day off and pinned shift locks: approving an availability request adds or
    // removes them, so managers may write them as well as editors.
    match /locks/{lockId} {
      allow read: if isApproved();
      allow write: if canApprove();
    }

    // ---------------------------------------------------------------------
    // Email log and audit trail hold full email bodies and history:
    // readable by editors only.
    // ---------------------------------------------------------------------
    match /emailLog/{docId} {
      allow read, write: if isEditor();
    }

    match /audit/{docId} {
      allow read: if isEditor();
      allow create: if canApprove();
      allow update, delete: if isOwner();
    }

    // Collections with their own rules above; the catch all below never applies to them.
    function SPECIAL_COLLECTIONS() {
      return ['userAccess', 'acknowledgments', 'emailLog', 'audit', 'publicRosters', 'leaveEntries', 'availabilityRequests', 'locks'];
    }

    // ---------------------------------------------------------------------
    // Every other clinic collection: approved users read, editors write.
    // ---------------------------------------------------------------------
    match /{collection}/{docId} {
      allow read: if isApproved() && !(collection in SPECIAL_COLLECTIONS());
      allow write: if isEditor() && !(collection in SPECIAL_COLLECTIONS());
    }
  }
}
